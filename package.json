{
  "name": "chandra-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-panchang.mjs",
    "test:panchang": "node --test tests/bengaluru-panchang.test.mjs tests/city-panchang.test.mjs tests/shared-panchang.test.mjs tests/timing-precision.test.mjs tests/moon-events.test.mjs",
    "test:panchang-build": "node --test tests/bengaluru-build.test.mjs tests/learn-build.test.mjs",
    "test:profile": "node --test tests/profile-timezone.test.mjs",
    "lint": "npm run check:radii && npm run check:typography && eslint .",
    "check:radii": "node scripts/check-radii.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "preview": "vite preview",
    "prebuild": "npm run check:radii && npm run check:typography && node scripts/prepare-city-pages.mjs",
    "predev": "node scripts/prepare-city-pages.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "canvas": "^3.2.3",
    "firebase": "^12.12.1",
    "lucide-react": "^1.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "vite-plugin-pwa": "^0.19.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  }
}
